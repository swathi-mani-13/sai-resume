# ==============================================================================
# SHACREATZ PORTFOLIO — VERCEL & SUPABASE ENVIRONMENT VARIABLES
# ==============================================================================
# Add these variables to your Vercel Project Settings:
# Vercel Dashboard -> Your Project -> Settings -> Environment Variables
#
# Get these values from:
# Supabase Dashboard -> Your Project -> Project Settings -> API
# ==============================================================================

# 1. Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Public Anonymous Key (safe to use in browser)
# DO NOT use the service_role key here. Use the 'anon' / 'public' key only.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional aliases for frameworks
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
